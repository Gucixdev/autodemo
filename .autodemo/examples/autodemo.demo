# autodemo demoing itself: check + preview of the ls demo
Size 100x24
Theme dark
Title "autodemo"
Setup printf "PS1='\\$ '\n" > $HOME/.bashrc
Cd /tmp
Run bash -i
Caption "Validate a script" bottom
Sleep 500ms
Send "$AUTODEMO_ROOT/autodemo list 2>&1 | head; $AUTODEMO_ROOT/autodemo check $AUTODEMO_ROOT/.autodemo/examples/ls.demo" 25
SendKey Enter
Sleep 2s
Caption "Bulk-check everything" bottom
Send "cd $AUTODEMO_ROOT && ./autodemo bulk check 2>&1 | tail -8" 25
SendKey Enter
Sleep 3s
Loop
