# qlogin: the terminal login greeter (fake PAM, private bus: nothing real is touched; the password in this demo is "secret")
Size 80x24
Theme dracula
Title "qlogin"
Cd /tmp
Run "$AUTODEMO_ROOT/../qlogin/rundemotui"
WaitFor "pwd" 15s
Caption "qlogin: login on the console, PAM, no GUI" bottom
Sleep 1s
Send "demo\t"
Sleep 300ms
Send "wrong\n"
Caption "a wrong password: the lockout delay grows" bottom
Sleep 2s
Send "secret\n"
Caption "nothing is drawn for the password; the login goes straight into the session" bottom
Sleep 2s
Loop
