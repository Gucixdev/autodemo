# generated by: autodemo gen ../bash/src/manwriter  (plain text, edit freely)
Size 100x28
Theme dracula
Title "manwriter"
Setup printf "PS1='\\$ '\n" > $HOME/.bashrc
Setup printf 'export PATH=%s:$PATH\n' "$AUTODEMO_ROOT/../bash/src" >> $HOME/.bashrc
Setup mkdir -p $HOME/proj/src && printf 'hello\n' > $HOME/proj/README.md && touch $HOME/proj/Makefile $HOME/proj/src/main.c
Setup printf '#!/bin/sh\n# hello - say hello\n# usage: hello [-n N]\n' > $HOME/proj/hello
Cd /tmp
Run bash -i
Send "cd ~/proj\n"
Sleep 400ms
Caption "manwriter" bottom
Caption "Step 1" bottom
Send "manwriter hello" 35
SendKey Enter
Sleep 1500ms
Caption "Step 2" bottom
Send "man -l hello.1 | head -n 8" 35
SendKey Enter
Sleep 1500ms
Loop
