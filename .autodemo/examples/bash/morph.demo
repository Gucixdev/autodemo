# generated by: autodemo gen ../bash/src/morph  (plain text, edit freely)
Size 100x28
Theme dracula
Title "morph"
Setup printf "PS1='\\$ '\n" > $HOME/.bashrc
Setup printf 'export PATH=%s:$PATH\n' "$AUTODEMO_ROOT/../bash/src" >> $HOME/.bashrc
Setup mkdir -p $HOME/proj/src && printf 'hello\n' > $HOME/proj/README.md && touch $HOME/proj/Makefile $HOME/proj/src/main.c
Setup magick -size 320x200 gradient:blue-red $HOME/proj/photo.png
Cd /tmp
Run bash -i
Send "cd ~/proj\n"
Sleep 400ms
Caption "morph" bottom
Caption "Step 1" bottom
Send "morph -l" 35
SendKey Enter
Sleep 1500ms
Caption "Step 2" bottom
Send "morph photo.png photo.webp" 35
SendKey Enter
Sleep 1500ms
Caption "Step 3" bottom
Send "ls -lgo photo.*" 35
SendKey Enter
Sleep 1500ms
Loop
