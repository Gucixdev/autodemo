#!/bin/sh
# tests: script validation, render to webp (container check), ascii preview. 0 arguments.
set -eu
cd "$(dirname "$0")/.."
A=${AUTODEMO_BIN:-./autodemo}; T=$(mktemp -d /tmp/autodemo-test-XXXXXX); fail() { echo "FAIL: $*"; exit 1; }
$A check .autodemo/examples/ls.demo >/dev/null || fail "check good"
if $A check test/bad.demo 2>$T/err; then fail "bad demo accepted"; fi
for s in "input before" "unknown command" "bad duration" "bad key" "size WxH"; do grep -q "$s" $T/err || fail "missing diagnostic: $s"; done
$A render .autodemo/examples/ls.demo -o $T/o.webp --snap 6000 $T/s.ppm >/dev/null || fail render
python3 -I - "$T/o.webp" <<'P' || fail "webp container"
import sys
d=open(sys.argv[1],'rb').read()
assert d[:4]==b'RIFF' and d[8:12]==b'WEBP' and b'ANIM' in d[:64] and d.count(b'ANMF')>3, "not animated webp"
assert len(d)<200_000, len(d)
P
head -c 2 $T/s.ppm | grep -q P6 || fail snap
$A preview .autodemo/examples/ls.demo | grep -q "README.md" || fail preview
$A render .autodemo/examples/ls.demo -o $T/o.webm >/dev/null || fail webm
[ -s $T/o.webm ] || fail "webm empty"
# Audio: a sound track under mp4 (a made-up tone, no file shipped); a missing file is a check error; webp says it ignored it
ffmpeg -loglevel error -y -f lavfi -i "sine=frequency=440:duration=1" $T/tone.mp3 || fail "ffmpeg tone"
printf 'Size 60x10\nAudio "tone.mp3" 0.5\nRun bash --norc\nSend "echo hi\\n"\nSleep 3s\n' > $T/au.demo
$A render $T/au.demo -o $T/au.mp4 >/dev/null 2>&1 || fail "audio render"
ffprobe -v error -show_entries stream=codec_type -of csv=p=0 $T/au.mp4 | grep -q audio || fail "no audio stream in mp4"
printf 'Audio "missing.mp3"\nRun ls\n' > $T/au2.demo
if $A check $T/au2.demo >/dev/null 2>$T/au2.err; then fail "missing audio accepted"; fi
grep -q "cannot read" $T/au2.err || fail "missing audio: no diagnostic"
$A render $T/au.demo -o $T/au.webp 2>&1 | grep -q "Audio ignored" || fail "webp audio note"
if command -v foot >/dev/null; then
  printf 'Window gui\nSize 600x300\nRun foot -F -e sh -c "echo gui-ok; exec sh"\nSleep 1s\nSend "echo x\\n"\nSleep 500ms\n' > $T/g.demo
  $A render $T/g.demo -o $T/g.webp >/dev/null 2>&1 || fail "gui render (foot)"
  [ -s $T/g.webp ] || fail "gui webp empty"
fi
# privacy gate: a screen that shows the login name / a token / an e-mail is refused (exit 4), --force keeps it, a clean one passes
printf 'Size 70x8\nRun bash --norc\nSleep 400ms\nSend "echo $(id -un) ghp_abcdefghijklmnopqrstuvwxyz0123 me@mail.pl\\n"\nSleep 600ms\n' > $T/leak.demo
rc=0; $A render $T/leak.demo -o $T/leak.webp 2>$T/leak.err >/dev/null || rc=$?
[ "$rc" = 4 ] || fail "leak demo not refused (exit $rc)"
for s in "login name" "token or key" "e-mail address"; do grep -q "$s" $T/leak.err || fail "leak not reported: $s"; done
if grep -q "$(id -un)" $T/leak.err; then fail "leak report repeats the login name"; fi
$A render $T/leak.demo -o $T/leak.webp --force >/dev/null 2>&1 || fail "--force should keep the leaky demo"
# Chrome on|off: header accepted, anything else refused
printf 'Chrome off\nRun ls\nSleep 200ms\n' > $T/c.demo; $A check $T/c.demo >/dev/null || fail "Chrome off rejected"
printf 'Chrome maybe\nRun ls\n' > $T/c2.demo; if $A check $T/c2.demo >/dev/null 2>&1; then fail "Chrome maybe accepted"; fi
# gui: WaitFor syntax (check only; no program needed)
printf 'Window gui\nRun true\nWaitFor title "x" 2s\nWaitFor settle 500ms 5s\n' > $T/w1.demo; $A check $T/w1.demo >/dev/null || fail "check WaitFor title/settle"
printf 'Window gui\nRun true\nWaitFor settle soon\n' > $T/w2.demo; if $A check $T/w2.demo 2>/dev/null; then fail "WaitFor settle without duration accepted"; fi
printf 'Run true\nClipboard "x"\n' > $T/w4.demo; if $A render $T/w4.demo -o $T/w4.webp >/dev/null 2>$T/err; then fail "Clipboard in a terminal demo accepted"; fi
printf 'Run true\nWaitFor title "x" 1s\n' > $T/w3.demo; if $A render $T/w3.demo -o $T/w3.webp >/dev/null 2>$T/err; then fail "WaitFor title in a terminal demo accepted"; fi
if python3 -I -c "import tkinter" 2>/dev/null && command -v Xwayland >/dev/null; then   # X11 client over rootful Xwayland: the picture must not be stripes, a click must arrive
  mark=$T/tkmark; printf 'Window x11\nSize 500x300\nRun env TK_MARK=%s python3 -I test/tkapp.py\nSleep 5s\nMouseMove 199 197 300\nMouseClick\nSleep 1500ms\n' "$mark" > $T/x.demo
  $A render $T/x.demo -o $T/x.webp --snap 4500 $T/x.ppm >$T/x.out 2>&1 || { cat $T/x.out; fail "gui render (Window x11: Tk app)"; }
  python3 -I - "$T/x.ppm" <<'P' || fail "Window x11 picture is wrong (stripes or empty)"
import sys
d = open(sys.argv[1], 'rb').read()
t = d.split(None, 4)           # P6 W H 255 pixels
w, h = int(t[1]), int(t[2]); px = d[len(d) - w * h * 3:]
at = lambda x, y: tuple(px[(y * w + x) * 3:(y * w + x) * 3 + 3])
a, b, c = at(120, 155), at(121, 155), at(122, 155)      # inside the red square of tkapp.py
assert a == b == c and a[0] > 180 and a[1] < 90 and a[2] < 90, (a, b, c)
P
  [ -s $T/tkmark ] || fail "Window x11: the click did not reach the Tk button"
fi
if python3 -I -c "import PySide6.QtWidgets" 2>/dev/null; then   # Qt test client: clicks, menu/combo popups, dismissal, keyboard, modal dialog
  $A render test/gui-qt.demo -o $T/qt.webp >$T/qt.out 2>&1 || { cat $T/qt.out; fail "gui render (Qt: clicks, popups, dialog)"; }
  $A render test/gui-clipboard.demo -o $T/clip.webp >$T/qt.out 2>&1 || { cat $T/qt.out; fail "gui render (Clipboard: wl_data_device paste into Qt)"; }
  $A render test/gui-qt-pl.demo -o $T/qtpl.webp >$T/qt.out 2>&1 || { cat $T/qt.out; fail "gui render (Layout pl: Polish letters)"; }
  printf 'Layout de\nRun true\n' > $T/l.demo; if $A check $T/l.demo 2>/dev/null; then fail "Layout de accepted"; fi
  printf 'Window gui\nSize 700x500\nRun python3 -I test/qtapp.py\nWaitFor title "qt:ready" 20s\nWaitFor title "never-appears" 1s\n' > $T/q.demo
  if $A render $T/q.demo -o $T/q.webp >$T/q.out 2>&1; then fail "WaitFor title timeout did not fail the render"; fi
  grep -q "no window title contains" $T/q.out || fail "WaitFor title timeout message"
  printf 'Window gui\nSize 700x500\nRun python3 -I test/qtapp.py\nWaitFor title "qt:ready" 20s\nWaitFor settle 400ms 10s\nCaption "settled"\nSleep 200ms\n' > $T/q2.demo
  $A render $T/q2.demo -o $T/q2.webp >$T/q.out 2>&1 || { cat $T/q.out; fail "WaitFor settle"; }
else echo "skip: PySide6 not installed (Qt gui tests)" >&2; fi
if AUTODEMO_TEST_FIREFOX=${AUTODEMO_TEST_FIREFOX:-1}; [ "$AUTODEMO_TEST_FIREFOX" = 1 ] && sh test/ffbox --probe >/dev/null 2>&1; then   # Firefox flatpak in bwrap: web-content clicks + <select> popup
  $A render test/gui-firefox.demo -o $T/ff.webp >$T/ff.out 2>&1 || { cat $T/ff.out; fail "gui render (Firefox: web content click, select popup)"; }
else echo "skip: Firefox flatpak/bwrap not available (or AUTODEMO_TEST_FIREFOX=0)" >&2; fi
# rec: a scripted "human" plays a shell in a pty (typing, a pause, Backspace, Up); the written .demo must check and replay
cat > $T/drive.py <<'P'
import pty, os, time, select, struct, fcntl, termios, sys
pid, fd = pty.fork()
if pid == 0:
    os.environ["TERM"] = "xterm-256color"; os.execv(sys.argv[1], ["autodemo", "rec", sys.argv[2], "--size", "80x20"])
fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", 24, 100, 0, 0))
def pump(t):
    end = time.time() + t
    while time.time() < end:
        if select.select([fd], [], [], 0.1)[0]:
            try: os.read(fd, 65536)
            except OSError: return
pump(2)
for c, d in [(b"echo hi", 0.1), (b"\r", 1.0), (b"abc", 0.1), (b"\x7f", 0.1), (b"\x1b[A", 0.3), (b"\x1d", 0.5)]:
    os.write(fd, c); pump(d)
os.waitpid(pid, 0)
P
python3 -I $T/drive.py "$(pwd)/$A" $T/rec.demo >/dev/null 2>&1 || fail "rec driver"
grep -q 'Send "echo hi\\n"' $T/rec.demo && grep -q "SendKey BSpace Up" $T/rec.demo && grep -q "^Sleep" $T/rec.demo || { cat $T/rec.demo; fail "rec wrote the wrong script"; }
$A check $T/rec.demo >/dev/null || fail "rec script does not check"
if $A rec $T/rec.demo >/dev/null 2>&1; then fail "rec overwrote a file"; fi
echo "all tests passed"
